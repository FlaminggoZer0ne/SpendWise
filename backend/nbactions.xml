<?xml version="1.0" encoding="UTF-8"?>
<!-- Aksi NetBeans: Run/Debug memakai spring-boot:run (bukan exec-maven-plugin bawaan). -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <jpda.listen>true</jpda.listen>
            <spring-boot.run.jvmArguments>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
        </properties>
    </action>
</actions>
